# Flask Backend Configuration
FLASK_APP=app
FLASK_ENV=development
SERVER_PORT=5000
SECRET_KEY=interview-assistant-secret-key-change-in-production

# Database Configuration
MONGO_URI=mongodb://db:27017/interview-assistant

# React Frontend Configuration  
REACT_APP_API_URL=http://localhost:5001
REACT_APP_WS_URL=ws://localhost:5001

# LLM Configuration (Optional - will use local Llama if not provided)
GEMINI_API_KEY=***
LLM_MODEL=gemini-1.5-flash

# HuggingFace Configuration (Optional - for downloading Llama models)
HUGGINGFACE_TOKEN=

# Local LLM Configuration
LOCAL_MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct
LOCAL_MODEL_PATH=./models/llama-1b-instruct
USE_LOCAL_MODEL=true

# Application Limits
MAX_SESSION_PARTICIPANTS=10
MAX_QUESTIONS_PER_TEMPLATE=20
SESSION_TIMEOUT_HOURS=24

# Rate Limiting (requests per minute/day)
LLM_REQUESTS_PER_MINUTE=15
LLM_REQUESTS_PER_DAY=1500