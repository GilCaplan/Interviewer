# Base configuration
MONGO_URI=mongodb://db:27017/interview-assistant
SECRET_KEY=dev-secret-key-change-in-production

# Server configuration
SERVER_PORT=5001
FLASK_APP=app/__init__.py
FLASK_ENV=development

# Client configuration
REACT_APP_API_URL="http://localhost:${SERVER_PORT}"
# Session Configuration
MAX_SESSION_PARTICIPANTS=20
MAX_QUESTIONS_PER_TEMPLATE=50
SESSION_TIMEOUT_HOURS=24

# WebSocket Configuration
REACT_APP_WS_URL=http://localhost:5000

# LLM Configuration - Gemini API (FREE TIER ONLY)
GEMINI_API_KEY=AIzaSyB_0rtZoh05NZatMXJi007dk8m6sgRsvb4
USE_MOCK_LLM=false

# Rate limiting to stay within free tier limits (conservative)
LLM_REQUESTS_PER_MINUTE=10
LLM_REQUESTS_PER_DAY=1000

# Optional: OpenAI backup (not used currently)
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7